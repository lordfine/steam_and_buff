{
  "name": "steam-and-buff",
  "version": "2.2.1",
  "description": "Steam 余额与 BUFF 挂刀、倒余额成本分析工具：CS2 / DOTA2 饰品比价、人民币行情复核、Steam 钱包净到账估算，支持本地桌面版和浏览器插件，中文界面，MIT 开源。",
  "private": true,
  "main": "desktop/main.js",
  "author": "lordfine",
  "license": "MIT",
  "scripts": {
    "start": "node build/start-desktop.js",
    "demo": "node build/start-desktop.js --demo",
    "dev": "node build/start-desktop.js --dev",
    "test": "node tests/run-tests.js && node tests/integration-test.js && node tests/buff-auth-regression.js && node --test tests/desktop.test.js",
    "test:e2e": "playwright test",
    "pack": "electron-builder --dir --win --x64",
    "dist": "electron-builder --win portable --x64",
    "build:extension": "node build/package.js",
    "test:extension": "node tests/extension-smoke.cjs",
    "build:brand": "node build/brand-assets.cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "electron": "44.7.2",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.steam.balance",
    "productName": "steam_and_buff·倒余额",
    "directories": {
      "output": "dist/desktop"
    },
    "files": [
      "desktop/**/*",
      "lib/**/*",
      "background.js",
      "icons/**/*",
      "package.json",
      "ui/**/*",
      "LICENSE"
    ],
    "asar": true,
    "win": {
      "target": "portable",
      "signAndEditExecutable": true,
      "icon": "icons/icon.ico",
      "signExecutable": false
    },
    "artifactName": "steam_and_buff-${version}-windows-${arch}.${ext}"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lordfine/steam_and_buff.git"
  }
}
