{
  "manifest_version": 3,
  "name": "SkinLedger · 饰账",
  "version": "2.2.0",
  "description": "BUFF / Steam 饰品比价工作台：成本率、人民币求购盘、流动性与行情新鲜度。只读，不自动交易。",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://buff.163.com/*",
    "https://steamcommunity.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SkinLedger · 饰账"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "120"
}
