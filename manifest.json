{
  "manifest_version": 3,
  "name": "steam_and_buff·倒余额",
  "version": "2.2.1",
  "description": "Steam 余额、BUFF 挂刀与倒余额成本分析：CS2 / DOTA2 饰品比价、人民币行情复核、挂单与求购净到账估算。中文界面，只读，不自动交易。",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://buff.163.com/*",
    "https://steamcommunity.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "steam_and_buff·倒余额"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "120"
}
